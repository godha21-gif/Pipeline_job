// CHANGE THIS:
stage('Build') {
    steps {
        echo 'Building the project...'
        sh 'your-build-command-here' // Delete or change this line
    }
}

// TO THIS (If using Windows Batch):
stage('Build') {
    steps {
        echo 'Building the project...'
        bat 'your-build-command-here' 
    }
}

// OR TO THIS (If using PowerShell):
stage('Build') {
    steps {
        echo 'Building the project...'
        powershell 'your-build-command-here'
    }
}
